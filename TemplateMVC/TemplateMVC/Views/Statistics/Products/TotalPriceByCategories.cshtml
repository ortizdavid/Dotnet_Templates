@model IEnumerable<TemplateMVC.Core.Models.Statistics.ProductTotalPriceByCategories>;

@{
    Layout = "_Layout";
    ViewBag.Title = "Total Prices by Categories";
}

<a href="/statistics/products" class="btn btn-link mt-3">
    <i class="bi bi-arrow-left"></i> Back to Statistics
</a>

<table class="table">
    <thead class="table-dark">
        <tr>
            <th>Category</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CategoryName</td>
                <td>@item.TotalPrice.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
