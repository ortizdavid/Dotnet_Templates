@model TemplateMVC.Core.Models.Statistics.UserPercentageActivesAndInactives;

@{
    Layout = "_Layout";
    ViewBag.Title = "Percentage Active and Inactive Users";
}

<a href="/statistics/users" class="btn btn-link mt-3">
    <i class="bi bi-arrow-left"></i> Back to Statistics
</a>

<table class="table">
    <thead class="table-dark">
        <tr>
            <th>Item</th>
            <th>Percent(%)</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Active Users</td>
            <td>@Model.ActivePercentage.ToString("0.00") %</td>
        </tr>
        <tr>
            <td>Inactive Users</td>
            <td>@Model.InactivePercentage.ToString("0.00") %</td>
        </tr>
    </tbody>
</table>
