@model IEnumerable<TemplateMVC.Core.Models.Statistics.SupplierTopSuppliers>;

@{
    Layout = "_Layout";
    ViewBag.Title = "Top Suppliers";
}

<a href="/statistics/suppliers" class="btn btn-link mt-3">
    <i class="bi bi-arrow-left"></i> Back to Statistics
</a>

<table class="table">
    <thead class="table-dark">
        <tr>
            <th>Supplier</th>
            <th>Count</th>
            <th>Percentage (%)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SupplierName</td>
                <td>@item.ProductCount</td>
                <td>@item.Percentage%</td>
            </tr>
        }
    </tbody>
</table>
